{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projects-lab",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  // OAuth client metadata documents (CIMD) are fetched only from public
  // addresses, so a client_id URL can't reach this zone's own origins.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": {
    "enabled": true
  },
  // Set with `wrangler secret put` (owner only); locally in .dev.vars.
  "secrets": {
    "required": ["TOKEN_SIGNING_KEY", "GITHUB_TOKEN", "UPLOAD_SIGNING_KEY"]
  },
  "vars": {
    // The app's public https origin, e.g. https://lab.example.com: the OAuth
    // issuer and the base of the MCP resource (<origin>/mcp) every token is
    // bound to. The owner sets it at the first deploy (F-20); the Worker
    // refuses to start without it. Locally it comes from .dev.vars.
    "PUBLIC_ORIGIN": "",
    // The study content repository (owner/name), read-only with GITHUB_TOKEN.
    "STUDY_MATERIALS_REPO": "jailsonsdsj/study-materials"
  },
  "assets": {
    // The Vite build (`pnpm --filter @projects-lab/web build`); build it before deploying.
    "directory": "../web/dist",
    // For /oauth/authorize, which serves the app's page from the Worker.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Never `true`: everything else is served by the assets layer without invoking the Worker.
    "run_worker_first": ["/api/*", "/mcp", "/oauth/*", "/.well-known/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "projects-lab",
      "database_id": "02e004fc-8c90-468e-97bf-286775b2ddaa",
      // Generated by drizzle-kit (`pnpm db:generate`); never hand-edited.
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "projects-lab-images"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "fc71f8aaf21c4276be39802ce915948e"
    }
  ],
  "env": {
    // Bindings are not inherited by environments; preview's D1, R2 and KV are added in G-03.
    "preview": {
      "name": "projects-lab-preview"
    }
  }
}
