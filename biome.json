{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/worker-configuration.d.ts",
      "!packages/api/migrations"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "overrides": [
    {
      "includes": ["packages/*/src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/labs",
                      "**/labs/**",
                      "**/study",
                      "**/study/**",
                      "**/career",
                      "**/career/**",
                      "!**/contracts/**"
                    ],
                    "message": "core never imports a lab."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/*/src/labs/study/**",
        "packages/shared/src/study/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/career", "**/career/**", "!**/contracts/**"],
                    "message": "A lab never imports another lab. Go through shared/src/contracts/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/*/src/labs/career/**",
        "packages/shared/src/career/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/study", "**/study/**", "!**/contracts/**"],
                    "message": "A lab never imports another lab. Go through shared/src/contracts/."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
