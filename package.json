{
  "name": "projects-lab",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "tsc -b",
    "lint": "biome check . && bash scripts/check-boundaries.sh --self-test && bash scripts/check-workflows.sh --self-test && bash scripts/check-workflows.sh && bash scripts/check-kdf-constant.sh && bash scripts/check-tokens.sh --self-test && bash scripts/check-tokens.sh",
    "format": "biome check --write .",
    "types": "pnpm --filter @projects-lab/api types",
    "db:generate": "pnpm --filter @projects-lab/api db:generate",
    "verify:triggers": "bash scripts/verify-triggers.sh",
    "seed": "bash scripts/seed.sh",
    "provision": "tsx scripts/provision.ts",
    "design:extract": "tsx scripts/design-extract.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:journeys": "playwright test -c e2e/journeys/playwright.config.ts",
    "lint:tokens": "bash scripts/check-tokens.sh --self-test && bash scripts/check-tokens.sh"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.1",
    "@projects-lab/shared": "workspace:*",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
